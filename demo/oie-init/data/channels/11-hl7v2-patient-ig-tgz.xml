          <fr.kazepoy.fhir.fml.FhirFmlTransformStep version="4.7.0">
            <name>PID XML to DevDays Patient</name>
            <sequenceNumber>0</sequenceNumber>
            <enabled>true</enabled>
            <fhirVersion>R4</fhirVersion>
            <context />
            <profiles>/fhir-volume/11-hl7v2-patient-ig-tgz/devdays.r4.example.conformanceresources-1.0.0.tgz</profiles>
            <terminologyServer>http://term-server:8500/fhir</terminologyServer>
            <mapUrl />
            <mapSource>map "http://example.org/fhir/StructureMap/AdtA28ToDevDaysPatient" = "AdtA28ToDevDaysPatient"

uses "https://openintegrationengine.org/fhir/StructureDefinition/OieMessage" alias OieMessage as source
uses "http://hl7.org/fhir/StructureDefinition/Patient" alias Patient as target

group AdtA28ToDevDaysPatient(source src : OieMessage, target patient : Patient) {
  src -> patient.meta as meta then {
    src -> meta.profile = 'http://devdays-example-ig.com/fhir/StructureDefinition/DevDaysIGtutorial-Patient' "profile";
  } "meta";
  src.node as pid where name = 'PID' then {
    pid.node as cx where name = 'PID.3' and node.where(position = 5 and value = 'PI').exists() then {
      cx.node as number where position = 1 -&gt; patient.identifier as identifier then {
        number -&gt; identifier.system = 'https://devdays-example-ig.com/NamingSystem/labPatientIdentifier' "system";
        number.value as v -&gt; identifier.value = v "identifier";
      } "ipp";
    } "identifiers";
    pid.node as xpn where name = 'PID.5' -&gt; patient.name as name then {
      xpn.node as family where position = 1 then { family.value as v -&gt; name.family = v "family"; } "family-name";
      xpn.node as given where position = 2 then { given.value as v -&gt; name.given = v "given"; } "given-name";
    } "name";
    pid.node as sex where name = 'PID.8' then {
      sex.node as code where position = 1 then {
        code.value as v -&gt; patient.gender = translate(v, 'http://example.org/fml-demo/ConceptMap/v2-sex-to-gender', 'code') "gender";
      } "gender-code";
    } "sex";
    pid.node as dob where name = 'PID.7' then {
      dob.node as time where position = 1 then {
        time.value as v where v.length() &gt;= 8 -&gt; patient.birthDate = (v.substring(0, 4) &amp; '-' &amp; v.substring(4, 2) &amp; '-' &amp; v.substring(6, 2)) "birthDate";
      } "birth-time";
    } "date-of-birth";
  } "pid";
}
</mapSource>
