{
  "resourceType": "StructureDefinition",
  "id": "DemoPatient",
  "url": "http://example.org/fml-demo/StructureDefinition/DemoPatient",
  "name": "DemoPatient",
  "title": "Demo patient with identity and gender",
  "status": "draft",
  "experimental": true,
