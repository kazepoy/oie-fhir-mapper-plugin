map "http://example.org/fhir/StructureMap/AdtA31" = "AdtA31"
uses "http://example.org/fhir/StructureDefinition/AdtA31" alias Input as source
uses "http://hl7.org/fhir/StructureDefinition/Patient" alias Patient as target

group AdtA31(source src : Input, target tgt : Patient) {
  src.identifier as value -> tgt.id = value "identifier";
}
