<pluginMetaData path="fhir-mapper">
  <name>FHIR Mapper</name>
  <author>kazepoy</author>
  <pluginVersion>${project.version}</pluginVersion>
  <mirthVersion>${oie.version}</mirthVersion>
  <description>Mapper graphique de profils FHIR, runtime et services de test. Transformation FML sur un modèle logique OIE. Requiert FHIR Data Type 1.6.1.</description>
  <serverClasses>
    <string>fr.kazepoy.fhir.mapper.server.FhirMapperPlugin</string>
    <string>fr.kazepoy.fhir.mapper.server.FhirMapperChannelPlugin</string>
    <string>fr.kazepoy.fhir.fml.server.FmlServicePlugin</string>
    <string>fr.kazepoy.fhir.fml.server.FmlChannelPlugin</string>
  </serverClasses>
  <library type="SHARED" path="fhir-mapper-server.jar" />
  <apiProvider type="SERVLET_INTERFACE" name="fr.kazepoy.fhir.mapper.FhirMapperServletInterface" />
  <apiProvider type="SERVER_CLASS" name="fr.kazepoy.fhir.mapper.server.FhirMapperServlet" />
  <apiProvider type="SERVLET_INTERFACE" name="fr.kazepoy.fhir.fml.FmlServletInterface" />
  <apiProvider type="SERVER_CLASS" name="fr.kazepoy.fhir.fml.server.FmlServlet" />
</pluginMetaData>
