{
  "name": "oie-fhir-mapper-web",
  "version": "0.6.1",
  "description": "Web Admin editors of the OIE FHIR Mapper: FHIR Mapper Transform and FHIR Mapping Language steps.",
  "license": "MPL-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node build.mjs",
    "capture:docs": "node scripts/capture-docs.mjs",
    "test": "node --test \"test/unit/**/*.test.js\"",
    "test:e2e": "node --test --test-concurrency=1 test/e2e/",
    "test:e2e:api": "node --test --test-concurrency=1 test/e2e/demo-*.test.js",
    "lint:js": "eslint .",
    "lint:css": "stylelint \"src/styles/*.css\"",
    "check": "node check.mjs && npm run lint:js && npm run lint:css"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "acorn": "8.19.0",
    "esbuild": "0.28.2",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "playwright": "1.64.1",
    "stylelint": "^18.0.0",
    "stylelint-config-standard": "^41.0.0"
  }
}
